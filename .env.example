# ==============================================================================
# EXPERIENCIAS.CLUB • Configuración de Variables de Entorno (.env.example)
# ==============================================================================
# Copiá este archivo como `.env.local` (o `.env`) para desarrollo local:
#   cp .env.example .env.local
#
# Para Producción:
#   Cargá estas mismas variables en el panel de Vercel (Project Settings -> Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de datos, Autenticación Google OAuth y Storage de respaldo)
# ------------------------------------------------------------------------------
# Obtené estos valores en: https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opcional) Si usás proyectos separados para Desarrollo y Producción:
# SUPABASE_DEV_URL=https://dev-proyecto.supabase.co
# SUPABASE_DEV_ANON_KEY=eyJhbGci...
# SUPABASE_PROD_URL=https://prod-proyecto.supabase.co
# SUPABASE_PROD_ANON_KEY=eyJhbGci...

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Almacenamiento de fotos, comprobantes y videos)
# ------------------------------------------------------------------------------
# Obtené Account ID y credenciales de API Token en:
# Cloudflare Dashboard -> R2 Object Storage -> Manage API Tokens
R2_ACCOUNT_ID=tu_cloudflare_account_id
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=experiencias-comprobantes

# URL pública asociada a tu bucket (ej. https://pub-xxxx.r2.dev o tu dominio personalizado https://cdn.catamarcasecreta.com)
R2_PUBLIC_URL=https://cdn.catamarcasecreta.com

# ------------------------------------------------------------------------------
# 3. NOTAS DE GOOGLE OAUTH EN SUPABASE
# ------------------------------------------------------------------------------
# En Supabase Dashboard -> Authentication -> URL Configuration:
# - Site URL: https://experiencias.club (en Prod) o http://localhost:4200 (en Dev)
# - Redirect URLs permitidas:
#     http://localhost:4200/**
#     http://localhost:3000/**
#     https://experiencias.club/**
#     https://admin.experiencias.club/**
#     https://prestadores.experiencias.club/**

# ------------------------------------------------------------------------------
# 4. RESEND (Notificaciones Automáticas por Email)
# ------------------------------------------------------------------------------
# Obtené tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_tu_api_key_aqui
# Remitente verificado en Resend (por defecto para pruebas o tu dominio validado ej. reservas@experiencias.club)
RESEND_FROM_EMAIL=Experiencias Club <onboarding@resend.dev>
# Correos de administración que reciben alertas automáticas cuando un socio sube un comprobante (separados por coma)
ADMIN_NOTIFICATION_EMAILS=gonzagramaglia@gmail.com,vegvarel@gmail.com,patriciofacundodiaztillar@gmail.com


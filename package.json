{
  "name": "experiencias-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter public dev",
    "build": "pnpm --filter public build",
    "dev:public": "pnpm --filter public dev",
    "build:public": "pnpm --filter public build",
    "build:admin": "pnpm --filter admin build",
    "build:providers": "pnpm --filter providers build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}

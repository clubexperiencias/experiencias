{
  "name": "experiencias-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "env": "node ./scripts/set-env.js",
    "dev": "node ./scripts/set-env.js && sh -c 'PORT=4200 npm run dev --workspace=apps/public' --",
    "build": "node ./scripts/set-env.js && npm run build --workspace=apps/public && node ./scripts/post-build.js",
    "dev:public": "node ./scripts/set-env.js && npm run dev --workspace=apps/public",
    "build:public": "node ./scripts/set-env.js && npm run build --workspace=apps/public && node ./scripts/post-build.js",
    "sync:src": "node ./scripts/sync-src.js",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}

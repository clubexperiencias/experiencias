{
  "name": "experiencias-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "sh -c 'PORT=4200 npm run dev --workspace=apps/public' --",
    "build": "node ./scripts/set-env.js && npm run build --workspace=apps/public",
    "dev:public": "npm run dev --workspace=apps/public",
    "build:public": "node ./scripts/set-env.js && npm run build --workspace=apps/public",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
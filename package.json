{
  "name": "experiencias-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace=apps/public",
    "build": "npm run build --workspace=apps/public",
    "dev:public": "npm run dev --workspace=apps/public",
    "build:public": "npm run build --workspace=apps/public",
    "start": "npm run start --workspace=apps/public",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ]
}